---
import { ArrowBendRightUp, ArrowRight, Leaf, Minus } from 'phosphor-svelte';
import ContactDialog from '../components/ContactDialog.svelte';
import MobileNav from '../components/MobileNav.svelte';
import ToolFinder from '../components/ToolFinder.svelte';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Something Something Labs home">
      <span>Something</span>
      <span>Something</span>
      <span>Labs</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="#work">Work</a>
      <a href="#tools">What it does</a>
      <a href="#offers">Ways to pay</a>
      <a href="#process">Process</a>
      <button type="button" data-contact-open>Contact</button>
    </nav>

    <button class="button button-primary header-cta" type="button" data-contact-open>
      Start somewhere <ArrowRight size={18} weight="bold" />
    </button>
    <MobileNav client:load />
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-kicker">Websites built as business tools</p>
        <h1 id="hero-title">
          Your website should<br />do more.
          <em>Put it to work.</em>
        </h1>
        <p class="hero-lede">
          We design and build websites that help people understand, calculate, compare, choose,
          and take the next step. Bring us the business problem. We'll work out what the website
          should do.
        </p>
        <div class="hero-actions">
          <button class="button button-primary" type="button" data-contact-open>
            Start somewhere <ArrowRight size={18} weight="bold" />
          </button>
          <a class="text-link" href="#offers">See the two ways to pay <ArrowRight size={18} /></a>
        </div>
        <p class="honest-note">
          <ArrowBendRightUp size={39} weight="regular" aria-hidden="true" />
          Somewhere to start: $1,490 upfront, then $299 a month for 24 months with care included.
        </p>
      </div>

      <figure class="hero-image">
        <img class="hero-sun" src="/images/print-sun.png" alt="" width="1254" height="1254" aria-hidden="true" />
        <img
          class="hero-photo"
          src="/images/hero-workbench.png"
          alt="A laptop displaying the 12Grapes vineyard website in a warm studio workspace"
          width="1536"
          height="1024"
        />
      </figure>
    </section>

    <section class="name-story" aria-labelledby="value-title">
      <div>
        <h2 id="value-title">More than a poster.</h2>
        <p class="name-answer">A good website should help someone do something.</p>
      </div>
      <p class="name-copy">
        We start with the business problem, not a page template. The answer might be a calculator,
        a guided choice, an interactive diagram, a sharper enquiry, or something nobody has named
        yet.
      </p>
      <Leaf class="name-leaf" size={150} weight="fill" aria-hidden="true" />
    </section>

    <section class="tool-section" id="tools" aria-labelledby="tools-title">
      <header class="tool-heading">
        <div>
          <p class="section-kicker">What could it do?</p>
          <h2 id="tools-title">Find the useful bit.</h2>
        </div>
        <p>
          Pick the place customers tend to get stuck. Here are a few ways a website could help.
        </p>
      </header>
      <ToolFinder client:load />
    </section>

    <section class="work-section" id="work" aria-labelledby="work-title">
      <header class="section-heading">
        <div>
          <p class="section-kicker">Selected work</p>
          <h2 id="work-title">Real businesses.<br />Working websites.</h2>
        </div>
        <p>Each one starts with what the business needs people to understand, trust, or do.</p>
      </header>

      <div class="projects">
        <a class="project" href="https://somethingsomethinglabs.github.io/website-12Grapes/" target="_blank" rel="noreferrer">
          <div class="project-image">
            <img src="/images/12grapes-home.jpg" alt="12Grapes Vineyard Services website home page" width="1425" height="891" loading="lazy" />
          </div>
          <div class="project-meta">
            <div>
              <strong>12Grapes Vineyard Services</strong>
              <span>Makes year-round vineyard support easier to understand and enquire about.</span>
            </div>
            <ArrowRight size={24} weight="bold" />
          </div>
        </a>

        <a class="project" href="https://servoict.com/" target="_blank" rel="noreferrer">
          <div class="project-image project-image-servo">
            <img src="/images/servo-ict.jpg" alt="Servo ICT website project artwork" width="1200" height="630" loading="lazy" />
          </div>
          <div class="project-meta">
            <div>
              <strong>Servo ICT</strong>
              <span>Turns a broad technology offer into a clearer path for small-business clients.</span>
            </div>
            <ArrowRight size={24} weight="bold" aria-hidden="true" />
          </div>
        </a>
      </div>
    </section>

    <section class="offers-section" id="offers" aria-labelledby="offers-title">
      <header class="offers-heading">
        <div>
          <p class="section-kicker">A smaller way to start</p>
          <h2 id="offers-title">Same website.<br />Two ways to pay.</h2>
        </div>
        <p>
          Pay for the build outright, or begin with a smaller payment and have us look after the
          site while you pay it off. The work and agreed scope stay the same.
        </p>
      </header>

      <div class="pricing-truth">
        <p class="pricing-truth-kicker">The useful difference</p>
        <p>
          Squarespace supports its software. We support the business using the website. That
          means a person who knows the project can make changes, check the enquiry path and help
          the site keep earning its place.
        </p>
      </div>

      <div class="offer-grid">
        <article class="offer-card">
          <div class="offer-card-heading">
            <div>
              <p class="offer-number">01</p>
              <h3>Build + handover</h3>
            </div>
            <p class="offer-price"><span>$</span>6,500 <small>AUD · FROM</small></p>
          </div>
          <p class="offer-summary">Own the finished site and choose whether we stay involved.</p>
          <ul>
            <li>Business and content workshop</li>
            <li>Custom structure, writing and visual direction</li>
            <li>One focused interactive feature in the agreed scope</li>
            <li>Smarter enquiry flow, analytics and search setup</li>
            <li>Testing, launch, training and source handover</li>
          </ul>
          <button class="button button-primary" type="button" data-contact-open data-contact-package="Build and handover">
            Ask about buying outright <ArrowRight size={18} weight="bold" />
          </button>
        </article>

        <article class="offer-card offer-card-featured">
          <p class="offer-badge">Lower upfront cost</p>
          <div class="offer-card-heading">
            <div>
              <p class="offer-number">02</p>
              <h3>Managed website</h3>
            </div>
            <div class="managed-price">
              <p class="offer-price"><span>$</span>1,490 <small>AUD TO START</small></p>
              <p class="offer-price-monthly">+ $299 <span>a month</span></p>
            </div>
          </div>
          <p class="offer-summary">The same website, with the build cost spread out and care included.</p>
          <ul>
            <li>The same agreed discovery, design and build</li>
            <li>Managed hosting, monitoring and backups</li>
            <li>Scheduled enquiry-form checks</li>
            <li>Up to 30 minutes of small changes each month</li>
            <li>A practical site review every three months</li>
          </ul>
          <p class="managed-breakdown">24 monthly payments from launch. $8,666 total including the initial payment.</p>
          <button class="button button-primary" type="button" data-contact-open data-contact-package="Managed website">
            Start with $1,490 <ArrowRight size={18} weight="bold" />
          </button>
        </article>
      </div>

      <div class="offer-details">
        <div>
          <p class="offer-detail-label">One scope, not a cut-down version</p>
          <p>We agree what the site needs to do before quoting. Both payment routes cover the same written scope, revision limits and finished website. The managed option is lower upfront, not lower total.</p>
        </div>
        <div>
          <p class="offer-detail-label">What happens after month 24?</p>
          <p>Choose a clean handover to hosting you control, or keep limited care for $89 a month. Your domain and business accounts stay in your name throughout.</p>
        </div>
      </div>

      <aside class="care-strip" aria-label="Optional website care">
        <div>
          <p class="section-kicker">Something should keep working</p>
          <h3>Support for the business, not only the software.</h3>
        </div>
        <p>When a service changes or an enquiry dries up, you have someone to call who already understands the site. Managed clients get small changes and regular checks during the 24-month term. Outright clients can add limited care for <strong>$89 a month</strong>.</p>
      </aside>

      <p class="scope-note">
        Online shops, customer accounts, complex booking systems, integrations and larger
        data-backed tools need their own quote. Prices are in AUD. If GST applies, your written
        proposal will show it, the full payment schedule and the total payable before you book.
      </p>
    </section>

    <section class="process-section" id="process" aria-labelledby="process-title">
      <header class="process-heading">
        <div>
          <p class="section-kicker">How a project starts</p>
          <h2 id="process-title">Start with some...</h2>
        </div>
        <p>
          You do not need to arrive with a feature list or all the answers. We only need enough
          to find the next useful step.
        </p>
      </header>

      <ol class="process-steps">
        <li>
          <span class="process-number" aria-hidden="true">01</span>
          <h3><span>Some</span>where</h3>
          <p>Tell us where people get stuck, what the team repeats, or what takes too much time.</p>
        </li>
        <li>
          <span class="process-number" aria-hidden="true">02</span>
          <h3><span>Some</span>thing</h3>
          <p>We work out what would help. It might be a page, a calculator, a guide, or a smarter flow.</p>
        </li>
        <li>
          <span class="process-number" aria-hidden="true">03</span>
          <h3><span>Some</span>how</h3>
          <p>We design and build it, show you the working version, and explain the choices as we go.</p>
        </li>
      </ol>
    </section>

    <section class="approach-section" id="approach" aria-labelledby="approach-title">
      <div class="approach-copy">
        <p class="section-kicker section-kicker-light">Our approach</p>
        <h2 id="approach-title" class="approach-title" aria-label="Modern tools. Human judgement.">
          <span class="approach-title-tools">Modern tools.</span>
          <span class="approach-title-human">Human</span>
          <span class="approach-title-judgement">judgement.</span>
        </h2>
        <p>
          Something Something Labs is an owner-operated studio based in Gippsland. I'm Rowan. I
          use modern tools, including AI, where they make the result quicker or more useful. I
          still ask the questions, make the design decisions, review the code, and take
          responsibility for the result.
        </p>
      </div>
      <ul class="approach-list">
        <li><Minus size={20} weight="bold" /> Start with the business problem</li>
        <li><Minus size={20} weight="bold" /> Make complex things easier to grasp</li>
        <li><Minus size={20} weight="bold" /> Build the useful interaction</li>
        <li><Minus size={20} weight="bold" /> Keep a person responsible</li>
      </ul>
      <p class="approach-note">Same neighbourhood.<br />Different ideas.<br />That's the point.</p>
    </section>

    <section class="closing-section" aria-labelledby="closing-title">
      <img class="closing-sun" src="/images/print-sun.png" alt="" width="1254" height="1254" aria-hidden="true" />
      <div>
        <h2 id="closing-title">Where do people get stuck?<br /><em>Let's build something that helps.</em></h2>
      </div>
      <div class="closing-actions">
        <button class="button button-primary" type="button" data-contact-open>
          Start somewhere <ArrowRight size={18} weight="bold" />
        </button>
        <a class="text-link" href="#tools">See what a site can do <ArrowRight size={18} /></a>
      </div>
      <Leaf class="closing-leaf" size={128} weight="fill" aria-hidden="true" />
    </section>
  </main>

  <footer class="site-footer">
    <a class="wordmark wordmark-small" href="#top" aria-label="Something Something Labs home">
      <span>Something</span><span>Something</span><span>Labs</span>
    </a>
    <p>Websites for small businesses,<br />based in Gippsland, Victoria.</p>
    <nav aria-label="Footer navigation">
      <a href="#work">Work</a>
      <a href="#tools">What it does</a>
      <a href="#offers">Ways to pay</a>
      <a href="#process">Process</a>
      <button type="button" data-contact-open>Contact</button>
    </nav>
  </footer>

  <ContactDialog client:load />
</BaseLayout>
